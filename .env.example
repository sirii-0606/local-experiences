# ==============================================================================
# Local & Experiences - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Extraction (NVIDIA NIM or Anthropic Claude)
# ------------------------------------------------------------------------------
# NVIDIA NIM API Key (e.g. nvapi-...)
NVIDIA_API_KEY=

# NVIDIA NIM Base URL (defaults to https://integrate.api.nvidia.com/v1)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA Model (defaults to meta/llama-3.2-11b-vision-instruct)
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Anthropic Claude API Key (optional alternative)
ANTHROPIC_API_KEY=

# Parser mode: "auto" (default: uses LLM if key present, else rules), "llm", or "rules"
INTENT_PARSER=auto

# Seconds to wait for the LLM before using the rule parser's answer (free NIM can queue ~30 s)
LLM_TIMEOUT_S=10

# ------------------------------------------------------------------------------
# 2. Weather API
# ------------------------------------------------------------------------------
# Optional. With WEATHER_PROVIDER=auto, free Open-Meteo is used first (hourly, humidity, wind)
# and an OpenWeatherMap key here is the backup when Open-Meteo is unreachable.
WEATHER_API_KEY=

# Weather Provider: "auto", "weatherapi", "openweathermap", or "openmeteo"
WEATHER_PROVIDER=auto

# ------------------------------------------------------------------------------
# 3. Admin Account Bootstrap
# ------------------------------------------------------------------------------
# Creates/promotes the admin on the first admin sign-in. The password must be 8+ characters,
# otherwise no admin is created.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Optional / Feature Flags
# ------------------------------------------------------------------------------
# Database file path (defaults to backend/data/local.db)
# DB_PATH=backend/data/local.db

# Enable Website v2 features (1 = enabled, 0 = disabled)
WEBSITE_V2=1

# 0 = no network for places, geocoding or chat weather (tests set this)
# LIVE_DATA=1
